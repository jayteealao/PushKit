# Copy this file to .env and adjust values for your local dev environment.
# docker compose auto-loads .env; all variables below have sane dev defaults
# built into docker-compose.yml (via ${VAR:-default} expansion), so .env is
# optional for a zero-config local spin-up.

# MinIO / S3-compatible storage
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=pushkit-dev
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000

# API authentication keys (format: key:username, comma-separated)
API_KEYS=dev-key-1:user1,dev-key-2:user2

# Server
DATABASE_URL=/data/pushkit.db
LISTEN_ADDR=:8000
